<button type="button" data-dwars-theme-toggle aria-pressed="false" class="group flex cursor-pointer items-center gap-1.5 rounded-full border border-white/40 bg-[#1b1b1b] px-2.5 py-1 transition-colors hover:border-dwars-pink dark:border-[#1b1b1b] dark:bg-white">
  <span class="relative block h-4 w-4">
    <img data-theme-icon="light" src="{{ dwars_asset_base }}/icons/maantje.png" alt="" class="h-full w-full object-contain transition-transform group-hover:scale-110">
    <img data-theme-icon="dark" src="{{ dwars_asset_base }}/icons/zonnetje.png" alt="" class="h-full w-full rounded-full object-contain transition-transform group-hover:scale-110" hidden>
  </span>
  <span data-theme-label class="text-[10px] font-bold uppercase tracking-wider text-white transition-colors group-hover:text-dwars-pink dark:text-[#1b1b1b]">Donker</span>
</button>
