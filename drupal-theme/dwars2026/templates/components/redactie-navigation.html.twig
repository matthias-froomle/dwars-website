{% if dwars_redactie_title or dwars_redactie_actions %}
  <section class="dwars-redactie-intro mb-16">
    {% if dwars_redactie_title %}
      {% include '@dwars2026/components/section-header.html.twig' with { title: dwars_redactie_title } %}
    {% endif %}
    {% if dwars_redactie_actions %}
      <nav class="flex flex-wrap gap-4" aria-label="{{ 'Editorial teams'|t }}">
        {% for action in dwars_redactie_actions %}
          <a href="{{ action.url }}" class="inline-block border-2 border-black bg-white px-6 py-2 font-heading uppercase tracking-wide text-black transition-colors hover:border-dwars-pink hover:bg-dwars-pink hover:text-white focus-visible:border-dwars-pink dark:border-white dark:bg-black dark:text-white dark:hover:border-dwars-pink dark:hover:bg-dwars-pink dark:hover:text-white">{{ action.label }}</a>
        {% endfor %}
      </nav>
    {% endif %}
  </section>
{% endif %}
