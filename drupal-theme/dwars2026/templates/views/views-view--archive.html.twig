<div{{ attributes.addClass('dwars-view', 'mx-auto', 'w-full', 'max-w-[1600px]', 'px-4', 'pb-12', 'pt-16', 'sm:px-6', 'lg:px-8', 'lg:pt-24') }}>
  {% if header %}<header class="dwars-archive-header mb-12 border-b border-black pb-6 pt-12 dark:border-white md:pt-0">{{ header }}</header>{% endif %}
  {{ exposed }}
  {{ attachment_before }}
  {{ rows }}
  {% if empty %}<div class="py-20 text-center text-xl">{{ empty }}</div>{% endif %}
  {{ pager }}
  {{ attachment_after }}
  {{ more }}
  {{ feed_icons }}
</div>
