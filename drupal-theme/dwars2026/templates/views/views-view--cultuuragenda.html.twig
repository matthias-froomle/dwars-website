<div{{ attributes.addClass('dwars-view', 'dwars-culture-agenda') }}>
  {{ title_prefix }}{{ title }}{{ title_suffix }}
  {% if header %}<header class="mb-6">{{ header }}</header>{% endif %}
  {{ exposed }}
  {{ attachment_before }}
  {% if rows %}<div class="dwars-culture-agenda__grid">{{ rows }}</div>{% elseif empty %}{{ empty }}{% endif %}
  {{ pager }}
  {{ attachment_after }}
  {{ more }}
  {% if footer %}<footer>{{ footer }}</footer>{% endif %}
  {{ feed_icons }}
</div>
