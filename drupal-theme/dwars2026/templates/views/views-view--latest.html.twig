{% if dwars_home_hero %}
  <div{{ attributes.addClass('mb-0', 'flex', 'flex-col', 'gap-8', 'xl:flex-row') }}>
    <div class="h-[420px] min-w-0 flex-none md:h-[520px] lg:h-[620px] xl:h-[550px] xl:flex-1">{{ dwars_home_hero }}</div>
    {% if dwars_home_sidebar_rows %}
      <div class="flex w-full shrink-0 flex-col gap-6 sm:flex-row xl:w-[200px] xl:flex-col">
        {% for row in dwars_home_sidebar_rows %}{{ row }}{% endfor %}
      </div>
    {% endif %}
  </div>
{% else %}
  <div{{ attributes.addClass('dwars-view') }}>{{ title_prefix }}{{ title }}{{ title_suffix }}{{ exposed }}{{ attachment_before }}{{ rows }}{{ empty }}{{ pager }}{{ attachment_after }}{{ more }}{{ feed_icons }}</div>
{% endif %}
