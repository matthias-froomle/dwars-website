<article{{ attributes.addClass('dwars-home-preview', 'group', 'relative', 'mb-4', 'flex-1', 'break-inside-avoid', 'border-b-2', 'border-white', 'pb-4', 'transition-all', 'duration-300', 'md:border-black', 'dark:border-white') }}>
  {{ title_prefix }}
  {% if dwars_section %}<span class="mb-2 block text-xs font-bold uppercase tracking-wider text-gray-300 md:text-gray-600 dark:text-gray-300">{{ dwars_section }}</span>{% endif %}
  <a href="{{ dwars_node_url }}" class="block">
    <h2{{ title_attributes.addClass('mb-2', 'font-heading', 'text-xl', 'uppercase', 'leading-tight', 'tracking-wide', 'text-white', 'transition-colors', 'group-hover:text-dwars-pink', 'md:text-black', 'dark:text-white') }}>{{ label }}</h2>
    {% if dwars_excerpt %}<p class="line-clamp-3 text-sm leading-relaxed text-gray-300 md:text-black dark:text-gray-400">{{ dwars_excerpt }}</p>{% endif %}
  </a>
  {{ title_suffix }}
</article>
