<article{{ attributes.addClass('group', 'border-b', 'border-gray-300', 'py-4', 'first:pt-0', 'last:border-0', 'last:pb-0', 'dark:border-gray-700') }}>
  <a href="{{ dwars_node_url }}" class="flex items-start gap-4">
    <span class="h-16 w-16 shrink-0 overflow-hidden bg-gray-200 grayscale transition-all duration-300 group-hover:grayscale-0 dark:bg-gray-700">
      {% if dwars_article_image %}{{ dwars_article_image }}{% endif %}
    </span>
    <span class="flex-1 text-sm font-bold uppercase leading-tight transition-colors group-hover:text-dwars-pink">{{ label }}</span>
  </a>
</article>
